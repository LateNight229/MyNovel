{
  "manifest_version": 2,
  "name": "Novel Reader Mode",
  "version": "1.0.0",
  "description": "Firefox Reader Mode for Vietnamese novel sites - clean reading experience with offline saving",

  "permissions": [
    "storage",
    "activeTab",
    "*://*.wattpad.com/*",
    "*://*.truyen.vn/*",
    "*://*.truyencv.com/*",
    "*://*.truyenlau.com/*",
    "*://*.truyenfull.com/*",
    "*://*.tvhai.vn/*",
    "*://*.webnovel.com/*",
    "*://*.novelupdates.com/*",
    "*://*.wordpress.com/*",
    "*://wordpress.com/*"
  ],

  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Novel Reader Mode",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "background": {
    "scripts": ["background-worker.js"],
    "persistent": false
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.wattpad.com/*",
        "*://*.truyen.vn/*",
        "*://*.truyencv.com/*",
        "*://*.truyenlau.com/*",
        "*://*.truyenfull.com/*",
        "*://*.tvhai.vn/*",
        "*://*.webnovel.com/*",
        "*://*.novelupdates.com/*",
        "*://*.wordpress.com/*",
        "*://wordpress.com/*"
      ],
      "js": [
        "content-detector.js",
        "storage-manager.js",
        "content-script.js"
      ],
      "css": ["content-style.css"],
      "run_at": "document_end"
    }
  ],

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}